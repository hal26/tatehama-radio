{
  "name": "radio-vc",
  "version": "1.0.0",
  "description": "Railway Style Radio VC Application",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build",
    "server": "node server/index.js",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.example.radio-vc",
    "productName": "RadioVC",
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  }
}